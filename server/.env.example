MONGO_URI=mongodb://localhost:27017/fixmycity
JWT_SECRET=your-super-secret-jwt-key-change-in-production
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Leave unset in production to disable the Flask/OpenCV verifier (Gemini fallback scoring is used)
AI_SERVICE_URL=http://localhost:5001
# Google AI Studio key — required for AI report/repair verification
# Get free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- Vercel production (set these in Project Settings → Environment Variables) ---
# MongoDB Atlas connection string (required)
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/fixmycity
# Vercel Blob read/write token (auto-created when Blob storage is enabled)
# BLOB_READ_WRITE_TOKEN=
# Required to allow POST /api/seed on Vercel (send via x-seed-token header)
# SEED_TOKEN=